# Copie ce fichier en .env (à la racine du projet) et remplis les valeurs
# avec celles de TON projet Firebase (Console Firebase > Paramètres du
# projet > Général > "Vos applications" > app Web > objet firebaseConfig).
#
# Le fichier .env ne doit JAMAIS être commité sur GitHub — il est déjà
# ignoré par .gitignore.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
